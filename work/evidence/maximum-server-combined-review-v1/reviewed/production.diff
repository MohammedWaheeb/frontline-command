+			wrapped, _ := NewReplay(e)
+			reused, _ := NewReplay(e)
+			issue(t, e, 1, Order{Kind: "move", Entities: []ID{2}, Position: Vec{X: 18000, Y: 16000}})
+			for _, r := range []*Replay{old, wrapped, reused} {
