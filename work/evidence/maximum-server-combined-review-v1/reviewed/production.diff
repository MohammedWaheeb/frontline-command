+		}
+		for y := int32(0); y < h; y++ {
+			for x := int32(0); x < w; x++ {
+				p := Vec{X: x * 500, Y: y * 500}
+				if got, want := grid[y*w+x], e.referenceClearExceptLookup(p, radius, 0, 0, false, false); got != want {
