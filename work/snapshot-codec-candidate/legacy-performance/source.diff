+		Position: toVec(v.Position),
+	}
+}
+func toVec(v content.Point) *pb.Vec {
+	return &pb.Vec{
+		X: v.X,
+		Y: v.Y,
+	}
+}
+func toZone(v sim.ZoneView) *pb.Zone {
