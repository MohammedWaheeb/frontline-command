{
  "$schema": "fc-design-tokens/2",
  "$description": "Frontline Command UI tokens v2 (2026-09-28): charcoal / warm gunmetal shell, olive paint, aged brass, restrained amber. Blue survives only as a tactical team colour. tokens.css and tokens.ts are generated by client/scripts/build-tokens.mjs. Values are px at UI scale 1.0.",
  "color": {
    "surface": {
      "0": "#0E0D0B",
      "1": "#161512",
      "2": "#1E1C18",
      "3": "#27241F",
      "4": "#322E27",
      "well": "#0B0A09",
      "scrim": "rgba(8, 7, 6, 0.74)"
    },
    "metal": {
      "dark": "#23211D",
      "base": "#3A3731",
      "light": "#555047",
      "edge": "#80786A",
      "bevel_hi": "rgba(255, 238, 205, 0.16)",
      "bevel_lo": "rgba(0, 0, 0, 0.55)",
      "seam": "#0C0B09"
    },
    "olive": { "dark": "#33361F", "base": "#4F5530", "light": "#6E7545", "paint": "#5B6138" },
    "brass": { "dark": "#6E5528", "base": "#A8843F", "light": "#D0AE66", "shine": "#EED9A2" },
    "amber": { "base": "#E2A232", "hover": "#F0B84E", "active": "#C58722", "dim": "rgba(226, 162, 50, 0.16)", "on": "#1A1206" },
    "line": { "1": "#2E2B25", "2": "#403B33", "3": "#5A5349" },
    "text": {
      "1": "#EDE6D6",
      "2": "#BDB4A2",
      "3": "#8A8273",
      "disabled": "#5E584D",
      "inverse": "#12100D",
      "stencil": "#D9CFB8"
    },
    "focus": { "ring": "#F4C24E", "halo": "rgba(244, 194, 78, 0.30)" },
    "status": {
      "ok": "#8DBA5E",
      "info": "#D7CBA8",
      "warn": "#E8A33A",
      "danger": "#D4432F",
      "critical": "#FF4A35",
      "ok_dim": "rgba(141, 186, 94, 0.16)",
      "warn_dim": "rgba(232, 163, 58, 0.16)",
      "danger_dim": "rgba(212, 67, 47, 0.20)"
    },
    "led": { "on": "#F2B340", "green": "#9FD45A", "red": "#FF5A3C", "off": "#2A2620", "glass": "#120F0B" },
    "resource": {
      "credits": "#E8C05A",
      "power": "#9FD45A",
      "power_low": "#E8A33A",
      "power_critical": "#FF5A3C",
      "supply": "#D5CCB6",
      "energy": "#B79BD6",
      "income": "#A8D07A"
    },
    "faction": {
      "US": { "paint": "#6E7358", "accent": "#C6B98A", "deep": "#20231A", "name": "United States" },
      "IR": { "paint": "#5E6B4A", "accent": "#B9C58E", "deep": "#1B2217", "name": "Iran" },
      "SY": { "paint": "#8A5E36", "accent": "#D79A5C", "deep": "#2A1C12", "name": "Syrian Rebels" },
      "SA": { "paint": "#A08655", "accent": "#E0C27E", "deep": "#2A2316", "name": "Saudi Arabia" }
    },
    "team": {
      "standard": ["#3E8EDE", "#D9463E", "#2BB3A6", "#E58A2E", "#9A6BD8", "#E6C229", "#4DAF62", "#D8DDE2"],
      "cvd_safe": ["#0072B2", "#D55E00", "#009E73", "#E69F00", "#CC79A7", "#F0E442", "#56B4E9", "#FFFFFF"],
      "relation": { "self": "#4DAF62", "ally": "#E6C229", "enemy": "#D9463E", "neutral": "#B9B4A6" }
    },
    "health": { "high": "#8DD05A", "mid": "#E8C23A", "low": "#E5482E", "track": "rgba(0, 0, 0, 0.65)" },
    "world": {
      "selection": "#A6E57A",
      "order_move": "#A6E57A",
      "order_attack": "#FF5A48",
      "order_attack_move": "#F2B340",
      "placement_valid": "#A6E57A",
      "placement_invalid": "#FF5A48",
      "range": "rgba(237, 230, 214, 0.55)",
      "missile_warning": "#FF4A35",
      "fog_unexplored": "#060605",
      "fog_explored": "rgba(8, 7, 6, 0.52)"
    }
  },
  "font": {
    "family": {
      "display": "'Big Shoulders Stencil Display', 'Barlow Condensed', sans-serif",
      "label": "'Barlow Condensed', 'Barlow', sans-serif",
      "ui": "'Barlow', system-ui, sans-serif",
      "mono": "'Share Tech Mono', ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 }
  },
  "type": {
    "display":   { "family": "display", "size": 52, "line": 52, "weight": 800, "tracking": "0.04em", "case": "upper" },
    "title":     { "family": "display", "size": 32, "line": 34, "weight": 700, "tracking": "0.05em", "case": "upper" },
    "heading":   { "family": "label", "size": 20, "line": 24, "weight": 700, "tracking": "0.06em", "case": "upper" },
    "panel":     { "family": "label", "size": 14, "line": 16, "weight": 700, "tracking": "0.12em", "case": "upper" },
    "body":      { "family": "ui", "size": 15, "line": 21, "weight": 500, "tracking": "0", "case": "none" },
    "body_sm":   { "family": "ui", "size": 13, "line": 18, "weight": 500, "tracking": "0", "case": "none" },
    "label":     { "family": "label", "size": 13, "line": 16, "weight": 600, "tracking": "0.07em", "case": "upper" },
    "cameo":     { "family": "label", "size": 13, "line": 14, "weight": 700, "tracking": "0.02em", "case": "none" },
    "caption":   { "family": "ui", "size": 12, "line": 15, "weight": 600, "tracking": "0.01em", "case": "none" },
    "readout":   { "family": "mono", "size": 22, "line": 24, "weight": 400, "tracking": "0.04em", "case": "none" },
    "numeric":   { "family": "mono", "size": 15, "line": 17, "weight": 400, "tracking": "0.02em", "case": "none" },
    "hotkey":    { "family": "mono", "size": 11, "line": 12, "weight": 400, "tracking": "0", "case": "upper" },
    "subtitle":  { "family": "ui", "size": 20, "line": 28, "weight": 600, "tracking": "0", "case": "none" }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20, "8": 24, "9": 32, "10": 40, "11": 48, "12": 64 },
  "radius": { "none": 0, "xs": 1, "sm": 2, "md": 3 },
  "border": { "hair": 1, "strong": 2, "focus": 2 },
  "chamfer": { "sm": 5, "md": 9, "lg": 16 },
  "shadow": {
    "raised": "inset 0 1px 0 rgba(255,238,205,0.16), inset 0 -1px 0 rgba(0,0,0,0.6), 0 1px 2px rgba(0,0,0,0.6)",
    "pressed": "inset 0 2px 3px rgba(0,0,0,0.7), inset 0 -1px 0 rgba(255,238,205,0.06)",
    "well": "inset 0 2px 4px rgba(0,0,0,0.85), inset 0 0 0 1px rgba(0,0,0,0.6), 0 1px 0 rgba(255,238,205,0.08)",
    "console": "0 -2px 0 rgba(0,0,0,0.5), 0 0 24px rgba(0,0,0,0.55)",
    "modal": "0 24px 64px rgba(0,0,0,0.7)"
  },
  "material": {
    "$description": "Raster chrome generated by assets/pipeline/ui/gen_chrome.py (9-slice, 2x). Slice insets are in 1x px.",
    "console_plate": { "file": "assets/build/ui/chrome/console_plate@2x.png", "slice": 18 },
    "well": { "file": "assets/build/ui/chrome/well@2x.png", "slice": 8 },
    "button": { "file": "assets/build/ui/chrome/button@2x.png", "slice": 6, "states": ["normal", "hover", "pressed", "disabled", "active"] },
    "cameo_frame": { "file": "assets/build/ui/chrome/cameo_frame@2x.png", "slice": 5 },
    "brass_bezel": { "file": "assets/build/ui/chrome/brass_bezel@2x.png", "slice": 10 },
    "noise": { "file": "assets/build/ui/chrome/metal_noise.png", "tile": 256 }
  },
  "motion": {
    "duration": { "instant": 0, "fast": 80, "base": 140, "slow": 240, "panel": 300 },
    "easing": { "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)", "mechanical": "cubic-bezier(0.5, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "reduced": { "duration_max": 80, "allow": ["opacity", "color"], "flash_max_hz": 3 }
  },
  "layout": {
    "hud": {
      "reference": [1280, 720],
      "sidebar_w": 248,
      "shoulder_h": 34,
      "shoulder_w": 560,
      "tray_h": 132,
      "tray_w": 780,
      "minimap": 216,
      "cameo_w": 104,
      "cameo_h": 78,
      "command_cell": 40,
      "alert_w": 300
    },
    "hud_1600": { "sidebar_w": 300, "shoulder_h": 38, "shoulder_w": 660, "tray_h": 150, "tray_w": 900, "minimap": 262, "cameo_w": 127, "cameo_h": 95, "command_cell": 46, "alert_w": 330 },
    "ui_scale": { "min": 0.85, "max": 1.5, "step": 0.05, "default": 1.0 },
    "minimap_scale": { "min": 0.8, "max": 1.6, "default": 1.0 },
    "subtitle_scale": { "min": 1.0, "max": 1.6, "default": 1.0 },
    "min_hit_target": 28,
    "z": { "world": 0, "world_overlay": 10, "hud": 100, "alerts": 200, "tooltip": 300, "modal": 400, "toast": 500, "captions": 600 }
  },
  "state": {
    "production_cameo": ["available", "hover", "pressed", "focus", "queued", "building", "paused_low_power", "paused_prerequisite", "unaffordable", "locked_tier", "cap_reached", "no_service_slot", "producer_disabled", "queue_full", "ready_to_place"],
    "button": ["normal", "hover", "pressed", "active", "focus_visible", "disabled", "loading"],
    "alert_priority": ["critical", "warning", "info", "ack"],
    "unit_badge": ["veteran", "elite", "concealed", "ambush_ready", "designated", "hull_down", "deployed", "returning", "emergency", "transit", "service"]
  }
}
