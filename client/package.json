  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
